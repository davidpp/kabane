{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		/* OpenTUI React binding: Bun-native react-jsx, OpenTUI JSX namespace. */
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react"
	}
}
