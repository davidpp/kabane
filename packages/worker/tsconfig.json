{
	"extends": "../../tsconfig.base.json",
	"include": ["src/**/*.ts", "*.ts"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"lib": ["ESNext"],
		// `/types` (not the package root) is where the `cloudflare:test` module
		// declaration lives in pool-workers >= 0.18.
		// "bun" is here only because @cabane/core's commit-linker, lint
		// collectors and file-ref deref use Bun globals; the hub never calls
		// those paths, but tsc walks the imported sources.
		"types": [
			"@cloudflare/workers-types/experimental",
			"@cloudflare/vitest-pool-workers/types",
			"bun"
		]
	}
}
