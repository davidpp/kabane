		"vitest": "5.1.1",
		"wrangler": "4.167.0"
	},
	"dependencies": {
		"@kabane/checklist": "workspace:*",
		"@kabane/core": "workspace:*",
		"@kabane/handoff": "workspace:*",
		"@kabane/registry": "workspace:*",
		"@kabane/outcome": "workspace:*",
		"@kabane/work": "workspace:*",
		"@kabane/questions": "workspace:*",
		"@modelcontextprotocol/sdk": "1.32.2",
		"jose": "6.2.18",
		"zod": "4.6.7"
