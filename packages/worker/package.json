		"@types/bun": "1.4.4",
		"tsgo": "npm:typescript@7.0.2",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	},
	"dependencies": {
		"@cabane/checklist": "workspace:*",
		"@cabane/core": "workspace:*",
		"@cabane/handoff": "workspace:*",
		"@cabane/outcome": "workspace:*",
		"@cabane/questions": "workspace:*",
		"@modelcontextprotocol/sdk": "1.32.2",
		"jose": "6.2.17",
		"zod": "4.6.7"
	}
