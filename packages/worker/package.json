{
	"name": "kabane-worker",
	"version": "0.1.0",
	"description": "Kabane hub: the sync log Durable Object and the cloud device serving MCP",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "tsc --noEmit && vitest run",
