{
	// The Cabane hub. Two SQLite-backed Durable Object classes: CabaneLog is the
	// ordered oplog every device syncs through; CabaneHub is the cloud device that
	// runs the core on DO SQLite, serves MCP over Streamable HTTP, and syncs with
	// the log on an alarm.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cabane-worker",
	"main": "src/index.ts",
	// >= 2024-04-03 is what makes RPC methods available on the DO stub.
	"compatibility_date": "2026-07-01",
	// The core reaches for node:os in one file (the device name), and the hub
	// uses node:async_hooks for the per-request actor; nodejs_compat provides
	// them.
	"compatibility_flags": ["nodejs_compat"],
	// Access is the only front door: no workers.dev, no preview URLs. The custom
	// domain is not in this file: each deploy names its own with
	// `wrangler deploy --domain <your-domain>` (docs/deploy.md, part 1).
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [
			{ "name": "CABANE_LOG", "class_name": "CabaneLog" },
			{ "name": "CABANE_HUB", "class_name": "CabaneHub" }
		]
	},
	// new_sqlite_classes (not new_classes): both objects keep their state in DO
	// SQLite, whose input/output gates give the total order the sync design rests on.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["CabaneLog", "CabaneHub"] }
	],
	// Access wiring. ACCESS_TEAM_DOMAIN, ACCESS_AUD, HUMAN_EMAIL and
	// SERVICE_ACTORS are placeholders filled from the Zero Trust dashboard at
	// deploy time, with `--var` or the CI deploy job (docs/deploy.md, 1.0 and 1.5).
	// Empty values are CLOSED: no human and no service is admitted until set.
	// SYNC_TOKEN is a secret (`wrangler secret put`), never a var.
	// ACCESS_DEV_UNVERIFIED must never appear here; it lives in .dev.vars only.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		"HUMAN_EMAIL": "",
		"SERVICE_ACTORS": "{}",
		"SYNC_INTERVAL_MINUTES": "5"
	}
}
