{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		/* @cabane/board is OpenTUI React; its .tsx reaches tsc through the import. */
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react"
	}
}
