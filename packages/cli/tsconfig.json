{
	"extends": "../../tsconfig.base.json",
	/* The board's declarations of its asset imports (`.scm`, `.wasm`) reach tsc only by name. */
	"include": ["**/*.ts", "**/*.tsx", "../board/src/assets.d.ts"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		/* @cabane/board is OpenTUI React; its .tsx reaches tsc through the import. */
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react"
	}
}
