{
	"name": "@kabane/jobs",
	"version": "0.1.0",
	"description": "Agent sessions in hc terminals: started from a project's .kabane/recipes/ with `kabane run`, listed with `kabane runs`, and run on a schedule with `kabane job`.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"types": "index.ts",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf node_modules",
		"build": "bun scripts/build.ts"
	},
	"devDependencies": {
		"@kabane/core": "workspace:*",
		"@kabane/extension": "workspace:*",
		"@types/bun": "1.4.5",
		"tsgo": "npm:typescript@7.0.2"
	},
	"kabane": {
		"extension": "./index.ts",
		"modules": "./modules.ts",
		"api": 1,
		"firstStep": "tab, then \"schedule a job\""
	}
}
