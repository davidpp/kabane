{
	"name": "@kabane/loop",
	"version": "0.1.0",
	"description": "Drives an issue, or a parent issue's subtasks, to done through coding harnesses, and adds run activity and dispatch to the board, where `a` on an issue opens its run form.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"types": "index.ts",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf node_modules",
		"build": "bun scripts/build.ts"
	},
	"dependencies": {
		"@kabane/acp": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@kabane/checklist": "workspace:*",
		"@types/bun": "1.4.5",
		"tsgo": "npm:typescript@7.0.2",
		"@kabane/core": "workspace:*",
		"@kabane/extension": "workspace:*"
	},
	"kabane": {
		"extension": "./index.ts",
		"api": 1,
		"firstStep": "press a on an issue to run it"
	}
}
