{
	"name": "@kabane/dispatch",
	"version": "0.1.0",
	"description": "Serves the setup-dispatch and grill skills, writes a project's dispatch skill from its own template, and reports when a project's copy has fallen behind it.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"types": "index.ts",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf node_modules",
		"build": "bun scripts/build.ts"
	},
	"devDependencies": {
		"@kabane/core": "workspace:*",
		"@kabane/extension": "workspace:*",
		"@types/bun": "1.4.4",
		"tsgo": "npm:typescript@7.0.2"
	},
	"kabane": {
		"extension": "./index.ts",
		"api": 1,
		"firstStep": "copilot: /setup-dispatch"
	}
}
