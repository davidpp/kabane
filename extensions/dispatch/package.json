{
	"name": "@cabane/dispatch",
	"version": "0.1.0",
	"description": "Writes a project's dispatch and grill skills from its own templates through its setup-dispatch skill, and reports when a project's copy has fallen behind them.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"types": "index.ts",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf node_modules",
		"build": "bun scripts/build.ts"
	},
	"devDependencies": {
		"@cabane/core": "workspace:*",
		"@cabane/extension": "workspace:*",
		"@types/bun": "1.4.4",
		"tsgo": "npm:typescript@7.0.2"
	},
	"kabane": {
		"extension": "./index.ts",
		"api": 1
	}
}
