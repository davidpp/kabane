# Scheduled pull for one Kabane device (Linux cron). Install with:
#   crontab -l 2>/dev/null | cat - kabane-sync-pull.cron | crontab -
# Assumes `kabane` was bun-linked into ~/.bun/bin and KABANE_HOME is the default ~/.kabane.
*/5 * * * * PATH=$HOME/.bun/bin:/usr/local/bin:/usr/bin:/bin KABANE_HOME=$HOME/.kabane $HOME/.bun/bin/kabane sync pull >> $HOME/.kabane/sync-pull.log 2>> $HOME/.kabane/sync-pull.error.log
